# syntax=docker/dockerfile:1
# ==============================================================================
# Standard Universal Go Dockerfile - Generated by godev
# ==============================================================================
FROM golang:1.26.2-alpine AS builder

ENV GOPRIVATE=github.com/acme/*
WORKDIR /app

RUN apk add --no-cache git openssh-client

COPY go.mod go.sum ./
# The deploy key is mounted for this layer only: pass it with
# docker build --secret id=godev_ssh_key,src=<key>, as godev does.
RUN --mount=type=secret,id=godev_ssh_key \
    if [ -s /run/secrets/godev_ssh_key ]; then \
      mkdir -p "$HOME/.ssh" && \
      cp /run/secrets/godev_ssh_key "$HOME/.ssh/id_ed25519" && \
      chmod 600 "$HOME/.ssh/id_ed25519" && \
      ssh-keyscan github.com >> "$HOME/.ssh/known_hosts" 2>/dev/null && \
      git config --global url."git@github.com:acme/".insteadOf "https://github.com/acme/"; \
    fi && \
    go mod download; \
    STATUS=$?; \
    rm -rf "$HOME/.ssh"; \
    git config --global --unset-all url."git@github.com:acme/".insteadOf 2>/dev/null || true; \
    exit $STATUS

COPY . .

RUN go generate ./... 2>/dev/null || true

RUN mkdir -p /app/bin && \
    for dir in cmd/*/; do \
      if [ -d "$dir" ]; then \
        bin=$(basename "$dir"); \
        echo "Building $bin from $dir..."; \
        CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /app/bin/$bin ./cmd/$bin; \
      fi; \
    done

# Runtime base stage (distroless non-root, 0 CVEs, no shell)
FROM gcr.io/distroless/static-debian12:nonroot AS runtime-base
WORKDIR /app

# Target: api
FROM runtime-base AS api
COPY --from=builder --chown=nonroot:nonroot /app/bin/api /app/bin/api
COPY --from=builder --chown=nonroot:nonroot /app/bin/api /app/api
USER nonroot:nonroot
EXPOSE 8080
CMD ["/app/bin/api"]

# Target: app (generic parameterized by TARGET build arg)
FROM runtime-base AS app
ARG TARGET=api
COPY --from=builder --chown=nonroot:nonroot /app/bin/${TARGET} /app/entrypoint
USER nonroot:nonroot
EXPOSE 8080
CMD ["/app/entrypoint"]
